# ---------------------------------------------------------------------------
# Minimates - Environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit files containing real secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL via Supabase connection pooler)
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Direct (non-pooled) connection - used by Prisma migrations
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin authentication
# Secret used to sign admin session JWTs (min 32 chars)
AUTH_SECRET=
# Seeded administrator account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments - active provider: "payhere" | "koko" | "cod"
PAYMENT_PROVIDER=payhere
# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
NEXT_PUBLIC_PAYHERE_MODE=sandbox
# Koko
KOKO_API_KEY=
KOKO_SECRET_KEY=
KOKO_BASE_URL=https://api.kokopay.io

# Public site URL (used for payment callbacks, sitemap, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Minimates

# Business contact
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Email (contact form / notifications)
EMAIL_API_KEY=
EMAIL_FROM=
